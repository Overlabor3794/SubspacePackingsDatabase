Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "and", " ", 
    RowBox[{"export", " ", ".", "exa"}], " ", 
    RowBox[{"and", " ", ".", "gos"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"$exportPackingChecks", "=", "False"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"GM", "=", 
          RowBox[{"G", "[", 
           RowBox[{"dims", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"LUT", "=", 
          RowBox[{"arraytoLUT", "@", 
           RowBox[{"TPslicefromGM", "[", "GM", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"LUT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Expand", "@", 
              RowBox[{"Numerator", "[", "#", "]"}]}], "/", 
             RowBox[{"Denominator", "[", "#", "]"}]}], "&"}], "/@", 
           RowBox[{"Together", "@", 
            RowBox[{"Expand", "@", 
             RowBox[{"LUT", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"exportPacking", "[", 
           RowBox[{"LUT", ",", 
            RowBox[{
             RowBox[{"filename", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<.exa\>\""}]}], "]"}],
           "//", "Quiet"}], ";", "\[IndentingNewLine]", 
         RowBox[{"exportPacking", "[", 
          RowBox[{
           RowBox[{"SOfromGM", "@", 
            RowBox[{"N", "[", 
             RowBox[{"GM", ",", 
              RowBox[{"2", "MachinePrecision"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"filename", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<.gos\>\""}]}], "]"}], 
         ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "dims", "]"}]}], "}"}]}], "]"}], "//", 
      "AbsoluteTiming"}]}], "\[IndentingNewLine]", "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ac130849-4d98-804a-aff1-a45c09422856"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", 
    SubscriptBox["\[Mu]", "2"], " ", "and", " ", 
    SubscriptBox["\[Mu]", "3"], " ", "using", " ", "previously", " ", 
    RowBox[{"exported", " ", ".", "exa"}], " ", "files"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TPS", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"importPacking", "[", 
          RowBox[{"#", "<>", "\"\<.exa\>\""}], "]"}], "&"}], "/@", 
        "filename"}], ",", "100"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"TPS", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"TPS", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1", ",", "j"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"TPS", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "j"}], "]"}], "]"}], "=", "0"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "TPS", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "@", 
        RowBox[{"TPS", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Mu]2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"#", "^", "2"}], ",", "2"}], "]"}], "*", 
          RowBox[{"Length", "[", "#", "]"}]}], "&"}], "/@", "TPS"}], "//", 
       "Rationalize"}]}], ";"}], "//", "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Mu]3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"#", "^", "3"}], ",", "2"}], "]"}], "*", 
          RowBox[{"Length", "[", "#", "]"}]}], "&"}], "/@", "TPS"}], "//", 
       "Rationalize"}]}], ";"}], "//", "AbsoluteTiming"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"30050515-fd52-0a4a-a502-e3fd6db57063"],

Cell[BoxData[
