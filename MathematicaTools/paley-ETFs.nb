Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Gram", " ", "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"G", "[", 
     RowBox[{"{", 
      RowBox[{"d_", ",", "n_"}], "}"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "diff"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"KroneckerSymbol", "[", 
           RowBox[{"j", ",", "n"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"1", "-", "n"}], ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"diff", "=", 
        RowBox[{
         RowBox[{"Flatten", "@", 
          RowBox[{"Outer", "[", 
           RowBox[{"Subtract", ",", 
            RowBox[{"Range", "[", "n", "]"}], ",", 
            RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "+", "n"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"[", "diff", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"n", " ", 
           RowBox[{"IdentityMatrix", "[", "n", "]"}]}], "-", 
          RowBox[{"(", 
           RowBox[{"n", "-", 
            RowBox[{"2", "d"}]}], ")"}], "+", 
          RowBox[{"I", " ", 
           RowBox[{"Sqrt", "[", "n", "]"}], "A"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "d"}], ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "[", 
     RowBox[{"d_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"G", "[", 
     RowBox[{"{", 
      RowBox[{"d", ",", "n"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"List", " ", "of", " ", 
     RowBox[{"(", 
      RowBox[{"d", ",", "n"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"n", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Prime", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"8", ",", 
         RowBox[{"PrimePi", "[", "499", "]"}]}], "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"#", ",", "4"}], "]"}], "==", "3"}], "&"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dims", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"#2", ",", "#3"}], "}"}]}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "/", "2"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "+", "1"}], ")"}], "/", "2"}], ",", "n"}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"Length", "[", "n", "]"}]}], ",", "2"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Construct", " ", "file", " ", 
      RowBox[{"names", ".", " ", "Files"}], " ", "will", " ", "be", " ", 
      "exported", " ", "to", " ", 
      RowBox[{"Packings", "/", "Paley"}]}], "-", 
     RowBox[{"ETFs", "/"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filename", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<Paley-ETFs/etf_\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<x\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<_6a\>\""}], "&"}],
       "/@", "dims"}]}], ";"}]}]}]], "Input",ExpressionUUID->"13772d20-e5d5-\
f641-b755-3aacf99fa44f"],

